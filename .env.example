# CampusSwap Production Environment Configuration
# Copy this file to .env and provide your actual Supabase project credentials.

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (Never use the service-role key in frontend client)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Application Configuration
VITE_APP_NAME=CampusSwap
VITE_APP_ENV=production

# Full Electronics Expert AI Assistant Configuration
# (Server-side ONLY — DO NOT prefix with VITE_ to keep API keys secure)
# Get a free Gemini API key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
# Optional alternative provider:
# OPENAI_API_KEY=your_openai_api_key_here
